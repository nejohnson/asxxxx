+    {	"B.6",			0x00F6,	0	},
+    {	"B.7",			0x00F7,	0	},
+    {	"CY",			0x00D7,	0	},
+    {	"DPH",			0x0083,	0	},
+    {	"DPL",			0x0082,	0	},
+    {	"EA",			0x00AF,	0	},
+    {	"F0",			0x00D5,	0	},
+    {	"IE",			0x00A8,	0	},
+    {	"IP",			0x00B8,	0	},
+    {	"OV",			0x00D2,	0	},
+    {	"P",			0x00D0,	0	},
+    {	"PCON",			0x0087,	0	},
+    {	"PS",			0x00BC,	0	},
+    {	"PSW",			0x00D0,	0	},
+    {	"RS0",			0x00D3,	0	},
