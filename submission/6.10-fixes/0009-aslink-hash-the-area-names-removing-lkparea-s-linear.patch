From 40721054e37515d129864b2c883dfdc1727e5cba Mon Sep 17 00:00:00 2001
From: Neil Johnson <njohnson@roku.com>
Date: Wed, 2 Sep 2026 11:48:33 +0100
Subject: [PATCH 09/26] aslink: hash the area names, removing lkparea()'s
 linear search

lkparea() resolved an area name by walking the linked list of
every area seen so far, once for each A directive read. A program
compiled with one area per function has as many areas as it has
functions, so the cost of reading its object files grows with the
square of the function count. Two further linear walks compound
it: appending a newly created area walked the list again to find
its tail, and matching an existing area walked that area's areax
chain to find its tail - the latter repeated a third time by
newarea() in the same file, immediately afterwards, to recover the
areax lkparea() had just appended.

Profiling a link of ten modules of a thousand one-function areas
each, with -m, shows where it lands:

  59.18%  0.29s  75,641,718 calls  symeq
  26.53%  0.13s      10,030 calls  lkparea
  10.20%  0.05s      50,056 calls  lkpsym

Of those 75.6 million symeq() calls roughly 50 million are
lkparea() comparing an area name against an ever longer list.

Give the areas a hash table. lkparea() looks a name up in
ahash[], the area records its own areax tail in a_axtp so both it
and newarea() can append in constant time, and areatp holds the
tail of the area list so a new area is linked without a walk.
The areas remain linked through a_ap in first seen order, which
is the order lnkarea() allocates them in and the order the map
lists them in, so nothing observable moves.

The hash is deliberately not the hash() of lksym.c. That function
sums the characters of a name, and area names generated per
function share a long common prefix and differ only in a short
suffix, so the sum takes few distinct values: over the ten
thousand area names of the benchmark above it reaches only 84
distinct buckets however many it is given, which would have
replaced a walk of 5,001 areas with a walk of 615. aname()
multiplies as it goes so the whole name reaches the result,
filling all 512 buckets with a longest chain of 42. It folds case
through ccase[] because lkparea() matches area names with
symeq(id, ap->a_id, 1), which ignores case unconditionally.

  10,000 sections, -m        0.75 s  ->  0.31 s
   2,000 sections, -m        0.03 s  ->  0.01 s
  10,000 sections, no map    0.72 s  ->  0.27 s

Verified with a standalone aslink built from linksrc/*.c against
one built from the current master:

- Output is unchanged: 81 comparisons - nine test programs
  (two-module, 2,000-section, 10,000-section, 10,000-symbols-in-
  one-area, long-symbol, crt0-style, 79- and 255-character area
  names, and the cross-module undefined-symbol case) against
  eight map option combinations (-m, -m1, -mc, -m -w, -m1 -w,
  -m -d, -m -q, -m1 -mc -w) plus the Intel Hex output of each -
  all identical.
- Area names are still matched without regard to case: two
  modules contributing to "MixedCase" and "MIXEDCASE" merge into
  a single four byte area, exactly as before.
- Area base addresses given with -a still resolve by name.
- .noi from -j, .cdb from -y, and the .rst files from the asz80
  self-tests tz80.bat and t80.bat are byte-for-byte identical.
- Built with -Wall with no new warnings, and with
  -fsanitize=address,undefined across -m, -m1 -mc -w, -m -j,
  -a with -m, and the 10,000 section link: no sanitizer reports.

This leaves lkpsym() as the largest remaining cost at this scale.
Enlarging NHASH alone will not help much - hash() saturates the
same way aname() was written to avoid - so that would mean
changing the symbol hash function too, which reorders symbols
sharing an address in the map. Not done here.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 linksrc/aslink.h | 11 +++++++
 linksrc/lkarea.c | 82 +++++++++++++++++++++++++++++++++++++-----------
 2 files changed, 75 insertions(+), 18 deletions(-)

diff --git a/linksrc/aslink.h b/linksrc/aslink.h
index 0c7b376..434ac71 100644
--- a/linksrc/aslink.h
+++ b/linksrc/aslink.h
@@ -202,6 +202,15 @@
 #define	NINPUT		512	/* Input buffer size */
 #define	NHASH	     (1 << 6)	/* Buckets in hash table */
 #define	HMASK	    (NHASH - 1)	/* Hash mask */
+
+/*
+ * Buckets in the area name hash table used by lkparea().  A
+ * program compiled with one area per function has as many areas
+ * as it has functions, so this is sized for thousands of them
+ * rather than for the handful a hand written program defines.
+ */
+#define	NAHASH	    (1 << 9)	/* Buckets in area hash table */
+#define	AHMASK	   (NAHASH - 1)	/* Area hash mask */
 #define	NLPP		60	/* Lines per page */
 #define	NMAX		78	/* IXX/SXX/DBX Buffer Length */
 #define		IXXMAXBYTES	32	/* NMAX > (2 * IXXMAXBYTES) */
@@ -609,7 +618,9 @@ struct	bank
 struct	area
 {
 	struct	area	*a_ap;	/* Area link */
+	struct	area	*a_hp;	/* Area name hash link, see lkparea() */
 	struct	areax	*a_axp;	/* Area extension link */
+	struct	areax	*a_axtp;/* Area extension list tail */
 	struct	bank	*a_bp;	/* Bank link */
 	FILE *	a_ofp;		/* Area File Handle */
 	a_uint	a_addr;		/* Beginning address of area */
diff --git a/linksrc/lkarea.c b/linksrc/lkarea.c
index 6aa3173..57eb564 100644
--- a/linksrc/lkarea.c
+++ b/linksrc/lkarea.c
@@ -246,12 +246,11 @@ newarea(void)
 	}
 
 	/*
-	 * Place pointer in header area list
+	 * Place pointer in header area list.  lkparea() has just
+	 * appended this A directive's areax to the area, so the
+	 * area's recorded tail is the areax wanted here.
 	 */
-	taxp = ap->a_axp;
-	while (taxp->a_axp) {
-		taxp = taxp->a_axp;
-	}
+	taxp = ap->a_axtp;
 	narea = hp->h_narea;
 	halp = hp->a_list;
 	for (k=0; k < narea ;++k) {
@@ -298,36 +297,83 @@ newarea(void)
  *		will terminate the linker.
  */
 
+/*
+ *	The area name hash table, the tail of the linked area
+ *	structures, and a hash of an area name.
+ */
+static	struct	area *	ahash[NAHASH];
+static	struct	area *	areatp;
+
+/*)Function	int	aname(id)
+ *
+ *		char *	id		pointer to the area name string
+ *
+ *	The function aname() hashes an area name into the ahash[]
+ *	table.  Area names are always matched without regard to
+ *	case, by symeq(id, ap->a_id, 1) in lkparea(), so the hash
+ *	folds case through ccase[] to match.
+ *
+ *	This is deliberately not the hash() of lksym.c.  That
+ *	function sums the characters of a name, which for names
+ *	sharing a long common prefix takes only a small number of
+ *	distinct values - measured over the ten thousand area names
+ *	of a one-area-per-function program it reaches just 84 of
+ *	them, however many buckets it is given.  Multiplying as it
+ *	goes mixes the whole name into the result instead.
+ *
+ *	local variables:
+ *		a_uint	h		computed hash value
+ *
+ *	global variables:
+ *		char	ccase[]		an array of characters which
+ *					perform the case translation
+ *
+ *	functions called:
+ *		none
+ *
+ *	side effects:
+ *		none
+ */
+
+static int
+aname(char *id)
+{
+	a_uint h;
+
+	h = 0;
+	while (*id) {
+		h = (h * 31) + (a_uint) (ccase[*id++ & 0x007F] & 0x00FF);
+	}
+	return ((int) (h & AHMASK));
+}
+
 void
 lkparea(char *id)
 {
-	struct area *tap;
-	struct areax *taxp;
+	int h;
 
-	ap = areap;
+	h = aname(id);
 	axp = (struct areax *) new (sizeof(struct areax));
-	while (ap) {
+	for (ap = ahash[h]; ap != NULL; ap = ap->a_hp) {
 		if (symeq(id, ap->a_id, 1)) {
-			taxp = ap->a_axp;
-			while (taxp->a_axp)
-				taxp = taxp->a_axp;
-			taxp->a_axp = axp;
+			ap->a_axtp->a_axp = axp;
+			ap->a_axtp = axp;
 			axp->a_bap = ap;
 			axp->a_bhp = hp;
 			return;
 		}
-		ap = ap->a_ap;
 	}
 	ap = (struct area *) new (sizeof(struct area));
 	if (areap == NULL) {
 		areap = ap;
 	} else {
-		tap = areap;
-		while (tap->a_ap)
-			tap = tap->a_ap;
-		tap->a_ap = ap;
+		areatp->a_ap = ap;
 	}
+	areatp = ap;
+	ap->a_hp = ahash[h];
+	ahash[h] = ap;
 	ap->a_axp = axp;
+	ap->a_axtp = axp;
 	axp->a_bap = ap;
 	axp->a_bhp = hp;
 	ap->a_id = strsto(id);
